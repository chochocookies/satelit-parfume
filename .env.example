# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgres://satelit:satelit@localhost:5432/satelit_parfume?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=satelit
DB_PASSWORD=satelit
DB_NAME=satelit_parfume

# ── Auth (wired up in Phase 2) ──────────────────────────
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=168

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object storage (wired up when product images land) ──
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ── Payment gateway: Duitku (wired up in Phase 8) ───────
# Sandbox by default — DUITKU_BASE_URL only needs to change once you
# have real production credentials confirmed against your Duitku
# merchant dashboard (see the root README's payment section).
DUITKU_MERCHANT_CODE=
DUITKU_MERCHANT_KEY=
DUITKU_BASE_URL=https://sandbox.duitku.com

# ── API ──────────────────────────────────────────────────
PORT=8080
GIN_MODE=release

# ── Public URLs ──────────────────────────────────────────
# How the backend refers to itself (webhook callback URL) and to the
# frontend (post-payment return URL) — a container can't know its own
# externally-reachable address on its own. localhost is correct for
# local dev; any real deployment needs real public HTTPS URLs here, or
# Duitku's servers can't reach the callback at all.
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
